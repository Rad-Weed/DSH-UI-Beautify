{
  "name": "dsh-ui-beautify",
  "version": "0.7.3",
  "description": "DSH UI Beautify（DSH 界面美化）· 给 DSH 页面加壁纸 + 真毛玻璃。模式：关闭（恢复默认）/ 纹理（乘法混合 + 毛玻璃）/ 背景（图真正垫底，文字/面板都在图上，主题薄纱）；可切换 deepseek / deepseek 黑白无水面（桌面图优先、包内兜底）；点击背景渐变恢复默认背景，2 秒后渐变恢复。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "beautify",
    "background",
    "theme"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "assets",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rad-Weed/DSH-UI-Beautify"
  }
}